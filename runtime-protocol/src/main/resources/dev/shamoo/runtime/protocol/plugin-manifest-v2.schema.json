{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shamoo.dev/schema/plugin-manifest-v2.schema.json",
  "title": "Shamoo plugin manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "displayName", "version", "shamoo", "platforms", "dependencies", "node", "reload", "compiler"],
  "properties": {
    "name": { "$ref": "#/$defs/pluginId" },
    "displayName": { "$ref": "#/$defs/nonWhitespace" },
    "version": { "$ref": "#/$defs/semver" },
    "shamoo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "runtime", "manifest"],
      "properties": {
        "api": { "$ref": "#/$defs/semverRange" },
        "runtime": { "$ref": "#/$defs/semverRange" },
        "manifest": { "const": 2 }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper", "velocity"],
      "properties": {
        "paper": { "$ref": "#/$defs/paperTarget" },
        "velocity": { "$ref": "#/$defs/velocityTarget" }
      },
      "anyOf": [
        { "properties": { "paper": { "properties": { "enabled": { "const": true } } } } },
        { "properties": { "velocity": { "properties": { "enabled": { "const": true } } } } }
      ]
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional", "loadBefore", "loadAfter"],
      "properties": {
        "required": { "$ref": "#/$defs/dependencyMap" },
        "optional": { "$ref": "#/$defs/dependencyMap" },
        "loadBefore": { "$ref": "#/$defs/pluginIdList" },
        "loadAfter": { "$ref": "#/$defs/pluginIdList" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builtins", "filesystem", "network", "workers", "childProcess", "nativeAddons"],
      "properties": {
        "builtins": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "maxLength": 256, "pattern": "^(node:)?[a-z][a-z0-9_/-]*$" } },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "$ref": "#/$defs/pathList" },
            "write": { "$ref": "#/$defs/pathList" }
          }
        },
        "network": { "type": "boolean" },
        "workers": { "type": "boolean" },
        "childProcess": { "type": "boolean" },
        "nativeAddons": { "type": "boolean" }
      }
    },
    "reload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["watch", "debounceMs", "preserveState"],
      "properties": {
        "watch": { "type": "boolean" },
        "debounceMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "preserveState": { "type": "boolean" }
      }
    },
    "compiler": { "$ref": "#/$defs/compiler" }
  },
  "$defs": {
    "nonWhitespace": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[\\s\\S]*[^\\s][\\s\\S]*$" },
    "semver": {
      "type": "string",
      "format": "semver",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "semverRange": { "type": "string", "minLength": 1, "maxLength": 256, "format": "semver-range", "pattern": "^[\\s\\S]*[^\\s][\\s\\S]*$" },
    "pluginId": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$" },
    "contractId": { "type": "string", "maxLength": 256, "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$" },
    "relativePath": {
      "anyOf": [
        { "const": "./" },
        { "type": "string", "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!\\.$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:/)\\.(?:/|$))(?!.*//)(?:\\./)?[^/]+(?:/[^/]+)*$" }
      ]
    },
    "pathList": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
    "pluginIdList": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/pluginId" } },
    "dependencyMap": { "type": "object", "maxProperties": 256, "propertyNames": { "$ref": "#/$defs/pluginId" }, "additionalProperties": { "$ref": "#/$defs/semverRange" } },
    "paperTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "const": false } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "minecraft", "paperApi", "nms", "packets"],
          "properties": {
            "enabled": { "const": true },
            "minecraft": { "$ref": "#/$defs/semverRange" },
            "paperApi": { "$ref": "#/$defs/semverRange" },
            "nms": { "type": "boolean" },
            "packets": { "type": "boolean" }
          }
        }
      ]
    },
    "velocityTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "const": false } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "velocityApi"],
          "properties": {
            "enabled": { "const": true },
            "velocityApi": { "$ref": "#/$defs/semverRange" }
          }
        }
      ]
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "components", "modules", "communication"],
      "properties": {
        "version": { "$ref": "#/$defs/nonWhitespace" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
        "communication": { "$ref": "#/$defs/communication" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "file", "platform", "decorators", "constructor", "properties", "methods", "location"],
      "properties": {
        "id": { "$ref": "#/$defs/nonWhitespace" },
        "kind": { "enum": ["plugin", "module", "component", "service", "event-listener", "command", "task"] },
        "name": { "$ref": "#/$defs/nonWhitespace" },
        "file": { "$ref": "#/$defs/nonWhitespace" },
        "platform": { "enum": ["common", "paper", "velocity"] },
        "decorators": { "type": "array", "items": { "$ref": "#/$defs/decorator" } },
        "constructor": { "type": "array", "items": { "$ref": "#/$defs/injection" } },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/injection" } },
        "methods": { "type": "array", "items": { "$ref": "#/$defs/method" } },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "decorators", "parameters", "location"],
      "properties": {
        "name": { "$ref": "#/$defs/nonWhitespace" },
        "lifecycle": { "enum": ["load", "enable", "ready", "drain", "disable", "unload"] },
        "invocation": { "enum": ["event", "command", "task", "packet"] },
        "decorators": { "type": "array", "items": { "$ref": "#/$defs/decorator" } },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/injection" } },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "decorator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arguments", "location"],
      "properties": {
        "name": { "$ref": "#/$defs/nonWhitespace" },
        "arguments": { "type": "array" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "location"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "property": { "$ref": "#/$defs/nonWhitespace" },
        "token": { "$ref": "#/$defs/token" },
        "optional": { "type": "boolean" },
        "all": { "type": "boolean" },
        "lazy": { "type": "boolean" },
        "name": { "$ref": "#/$defs/nonWhitespace" },
        "qualifier": { "$ref": "#/$defs/nonWhitespace" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["class", "token"] },
        "name": { "$ref": "#/$defs/nonWhitespace" },
        "module": { "$ref": "#/$defs/nonWhitespace" },
        "value": {}
      },
      "oneOf": [
        { "required": ["name", "module"], "not": { "required": ["value"] } },
        { "properties": { "kind": { "const": "token" } }, "required": ["value"], "not": { "anyOf": [{ "required": ["name"] }, { "required": ["module"] }] } }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "imports", "declarations", "exports", "global", "location"],
      "properties": {
        "id": { "$ref": "#/$defs/nonWhitespace" },
        "name": { "$ref": "#/$defs/nonWhitespace" },
        "imports": { "type": "array", "items": { "$ref": "#/$defs/import" } },
        "declarations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonWhitespace" } },
        "exports": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonWhitespace" } },
        "global": { "type": "boolean" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "forwardRef"],
      "properties": {
        "id": { "$ref": "#/$defs/nonWhitespace" },
        "forwardRef": { "type": "boolean" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "column"],
      "properties": {
        "file": { "$ref": "#/$defs/nonWhitespace" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["services", "events", "consumers"],
      "properties": {
        "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "componentId", "methods"],
      "properties": {
        "id": { "$ref": "#/$defs/contractId" },
        "version": { "$ref": "#/$defs/semver" },
        "componentId": { "$ref": "#/$defs/nonWhitespace" },
        "methods": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonWhitespace" } }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/contractId" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versionRange", "dependentReload"],
      "properties": {
        "id": { "$ref": "#/$defs/contractId" },
        "versionRange": { "$ref": "#/$defs/semverRange" },
        "dependentReload": { "enum": ["keep-running", "reload"] }
      }
    }
  }
}
